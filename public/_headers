# Netlify / Cloudflare Pages cache headers. Other hosts ignore this file
# (public/.htaccess covers Apache). See README.md, "Deploy notes".

# Content-hashed JS, CSS and fonts: a changed file is a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep their names across deploys.
/images/*
  Cache-Control: public, max-age=604800

/video/*
  Cache-Control: public, max-age=604800
