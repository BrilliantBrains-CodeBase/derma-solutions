# Derma Solutions — static build (the contents of dist/).
# Read by Apache, LiteSpeed and cPanel hosts only; every other host ignores it.
# What the site needs from a host is in README.md, "Deploy notes".

Options -Indexes -MultiViews
DirectoryIndex index.html

# Every URL ends in "/" and is a folder holding index.html. DirectorySlash
# (Apache's default) 301s /about-us to /about-us/, the canonical form.
DirectorySlash On

# A real 404 status with the site's own page. No SPA fallback to /index.html:
# it would serve the homepage's <head> on every unknown URL.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> bare domain, and http -> https. Uses the request's own host, so a
  # staging domain keeps working. The X-Forwarded-Proto check stops a redirect
  # loop behind a proxy or CDN that terminates TLS.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Other hosts' config files, shipped alongside this one — not pages.
<FilesMatch "^(_headers|_redirects)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Pages and crawler files: always revalidate, so a deploy shows at once.
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # JS, CSS and fonts live only in /assets/ with a content hash in the name,
  # so a changed file is a new URL and these can be cached for a year.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images keep their names across deploys: a week, then revalidate.
  <FilesMatch "\.(jpe?g|png|webp|avif|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
