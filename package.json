{
  "name": "dermasolutions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite-react-ssg dev",
    "build": "vite-react-ssg build && npm run seo:sitemap",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "seo:registry": "tsx scripts/build-seo-registry.ts",
    "seo:stubs": "tsx scripts/generate-page-stubs.ts",
    "seo:sitemap": "tsx scripts/generate-sitemap.ts",
    "seo:assets": "tsx scripts/copy-brand-assets.ts",
    "assets:home": "tsx scripts/import-home-images.ts",
    "assets:appointment": "tsx scripts/import-appointment-doctor.ts",
    "assets:doctors": "tsx scripts/import-doctor-images.ts",
    "assets:treatments": "tsx scripts/import-treatment-images.ts",
    "content:treatments": "tsx scripts/extract-treatment-content.ts",
    "seo:verify": "tsx scripts/verify-seo.ts && tsx scripts/verify-links.ts",
    "seo:routes": "tsx scripts/generate-routes.ts",
    "seo:generate": "npm run seo:registry && npm run seo:stubs && npm run seo:routes && npm run seo:assets && npm run seo:icons",
    "seo:icons": "tsx scripts/generate-icons.ts",
    "seo:links": "tsx scripts/verify-links.ts",
    "content:blog": "tsx scripts/extract-blog-content.ts",
    "content:gallery": "tsx scripts/fetch-video-gallery.ts",
    "content:videos": "tsx scripts/fetch-latest-videos.ts",
    "content:video-posters": "tsx scripts/fetch-video-posters.ts",
    "assets:blog": "tsx scripts/import-blog-images.ts",
    "assets:gallery": "tsx scripts/import-gallery-images.ts",
    "assets:media": "tsx scripts/import-media-images.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.0",
    "node-html-parser": "^9.0.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-react-ssg": "^0.9.2"
  }
}
